#!/bin/bash
# Development tools for local debugging
# Use it in your terminal:
# $ source ./devtools

# If I'm being executed, refuse, I must be sourced
if [[ $BASH_SOURCE == ${0} ]]; then
  printf "Don't execute me, do this instead:\n\$ source devtools\n"
  chmod -x devtools
  exit
fi

if [ ! -d .venv ] || [ ! -d kafka ]; then
  printf "Set up your environment first:\n$ ./manager setup\n"
  return
fi

notools() {
  deactivate
  unalias manager
  unset -f notools
}

source .venv/bin/activate
printf "Type notools in your terminal quit from devtools\n"

alias manager=$(realpath ./manager)

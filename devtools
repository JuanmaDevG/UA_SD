#!/bin/bash
# Development tools for local debugging
# Use it in your terminal:
# $ source ./devtools

# If I'm being executed, refuse, I must be sourced
if [[ $BASH_SOURCE == ${0} ]]; then
  printf "Don't execute me, do this instead:\n\$ source devtools\n"
  chmod -x devtools
  exit
fi

if [[ $BASH_SOURCE == */* ]]; then
  PROJECT_DIR="$(realpath "${BASH_SOURCE%/*}")"
else
  PROJECT_DIR="$(realpath .)"
fi

KAFKA_VERSION="${KAFKA_VERSION:-4.3.1}"
WM_KAFKA="${WM_KAFKA:-localhost:9092}" # broker used by the wm_* helpers
WM_PORT="${WM_PORT:-5000}"             # CENTRAL socket port used by the wm_* helpers

echo "Type 'h' in your terminal to see available devtools"
usage_message=$(
  cat <<EOT
Commands:
  h                 - Print this help message
  notools           - Unload devtools
  manager <option>  - Manage this project development environment
    <option>:
      build              - Build the container (image 'wm')
      run <module> [...] - Run a module in the container (host network), e.g. manager run WM_Central/WM_Central.py 5000 localhost:9092
      setup              - Create the py virtual environment and download kafka
      reset              - Reset py virtual environment and kafka installation
  kafka <option>    - Local Kafka broker (needs Java 17+)
    <option>:  start | stop | topics | mktopics | clean
  Run modules locally (broker: \$WM_KAFKA, central port: \$WM_PORT):
  wm_central                - CENTRAL (database in .log/wm.db)
  wm_fo <op_id> [file]      - Field Operator, e.g. wm_fo 1 services.txt
  wm_ws_m <port> <id> [name x y] - Station monitor, e.g. wm_ws_m 6001 1 "River Park" 10 20
  wm_ws_e <port>            - Station engine, connects to the monitor on localhost:<port>
  wm_tests [TestCase]       - Run the test suite (or one test case); -l lists them
EOT
)

h() {
  printf "%s\n" "$usage_message"
}

manager() {
  local option="$1"
  shift
  local DIR
  DIR=$(pwd)
  cd "$PROJECT_DIR" || return 1

  case "$option" in
  build) docker build -t wm . ;;
  run)
    if [ $# -lt 1 ]; then
      echo "manager: usage: manager run <WM_Central/WM_Central.py|WM_FO/WM_FO.py|WM_WS/WM_WS_M.py|WM_WS/WM_WS_E.py> [args...]"
    else
      docker run --rm -it --network host wm "$@"
    fi
    ;;
  setup)
    if [ ! -d .venv ]; then
      echo "manager: Making virtual environment..."
      python3 -m venv .venv
      source .venv/bin/activate
      pip install -r requirements.txt
    else
      echo "manager: py virtual environment ready"
    fi

    if [ ! -d kafka ]; then
      echo "manager: Downloading kafka ${KAFKA_VERSION}..."
      # archive.apache.org keeps every release (dlcdn only keeps the latest ones)
      if curl -fL "https://archive.apache.org/dist/kafka/${KAFKA_VERSION}/kafka_2.13-${KAFKA_VERSION}.tgz" -o kafka.tgz; then
        mkdir kafka
        tar -xzf kafka.tgz -C kafka --strip-components=1
      else
        echo "manager: kafka download failed (check KAFKA_VERSION=${KAFKA_VERSION})"
      fi
      rm -f kafka.tgz
    else
      echo "manager: kafka binaries ready"
    fi
    ;;
  reset)
    kafka stop 2>/dev/null
    rm -rf .venv kafka
    manager setup
    ;;
  *)
    h
    ;;
  esac

  cd "$DIR" || return 1
}

kafka() {
  local K="$PROJECT_DIR/kafka"
  local CONF="$K/config/wm.properties"
  local DATA="$PROJECT_DIR/.kafka-data"

  case "$1" in
  start)
    if [ ! -d "$K" ]; then
      echo "kafka: not installed, run: manager setup"
      return 1
    fi
    if ! command -v java >/dev/null; then
      echo "kafka: Java 17+ is required (e.g. sudo apt install openjdk-17-jre-headless)"
      return 1
    fi
    # same as the default KRaft config, but with the data inside the project
    if [ ! -f "$CONF" ]; then
      sed "s|^log.dirs=.*|log.dirs=$DATA|" "$K/config/server.properties" >"$CONF"
    fi
    if [ ! -d "$DATA" ]; then
      "$K/bin/kafka-storage.sh" format --standalone -t "$("$K/bin/kafka-storage.sh" random-uuid)" -c "$CONF"
    fi
    "$K/bin/kafka-server-start.sh" -daemon "$CONF"
    echo "kafka: starting on localhost:9092 (logs in kafka/logs/server.log)"
    ;;
  stop)
    "$K/bin/kafka-server-stop.sh" 2>/dev/null && echo "kafka: stopped"
    ;;
  topics)
    "$K/bin/kafka-topics.sh" --bootstrap-server "$WM_KAFKA" --list
    ;;
  mktopics)
    local t
    for t in watering-requests op-control ws-control ws-state op-state; do
      "$K/bin/kafka-topics.sh" --bootstrap-server "$WM_KAFKA" --create --if-not-exists --topic "$t"
    done
    ;;
  clean)
    kafka stop
    sleep 2
    rm -rf "$DATA"
    echo "kafka: data removed"
    ;;
  *)
    echo "kafka: usage: kafka <start|stop|topics|mktopics|clean>"
    ;;
  esac
}

# --- run the modules locally (inside the virtual environment) -----------------
wm_central() {
  (cd "$PROJECT_DIR" && LOG_DIR="${LOG_DIR:-$PROJECT_DIR/.log}" python3 WM_Central/WM_Central.py "$WM_PORT" "$WM_KAFKA")
}

wm_fo() {
  (cd "$PROJECT_DIR" && python3 WM_FO/WM_FO.py "$WM_KAFKA" "$@")
}

wm_ws_m() {
  (cd "$PROJECT_DIR" && python3 WM_WS/WM_WS_M.py "$1" "localhost:$WM_PORT" "$WM_KAFKA" "${@:2}")
}

wm_ws_e() {
  (cd "$PROJECT_DIR" && python3 WM_WS/WM_WS_E.py "localhost:$1")
}

wm_tests() {
  (cd "$PROJECT_DIR" && python3 run_tests "$@")
}

notools() {
  deactivate 2>/dev/null
  unset usage_message
  unset PROJECT_DIR KAFKA_VERSION WM_KAFKA WM_PORT

  unset -f notools
  unset -f manager
  unset -f kafka
  unset -f wm_central wm_fo wm_ws_m wm_ws_e wm_tests
  unset -f h
}

if [ ! -d "$PROJECT_DIR/.venv" ] || [ ! -d "$PROJECT_DIR/kafka" ]; then
  manager setup
fi

source "$PROJECT_DIR/.venv/bin/activate"

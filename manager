#!/bin/bash

DIR=$(pwd)

usage_message=$(
  cat <<EOF
Usage:
  manager <option>

Available options:
  build         - Build the container
  setup         - Make environment for local development
EOF
)

# Temporarily move to the project's root to make operations
cd $(realpath ${BASH_SOURCE%/*})

case "$1" in
build) docker build -t wm . ;;
setup)
  if [ ! -d .venv ]; then
    echo "manager: Making virtual environment..."
    python3 -m venv .venv
    source .venv/bin/activate
    pip install -r requirements.txt
  else
    echo "manager: py virtual environment ready"
  fi

  if [ ! -d kafka ]; then
    echo "manager: Downloading kafka..."
    curl https://dlcdn.apache.org/kafka/4.3.1/kafka-4.3.1-src.tgz >kafka.tgz
    tar -xf kafka.tgz
    rm kafka.tgz
    rename 's/kafka_.*/kafka/' kafka_*
  else
    echo "manager: kafka binaries ready"
  fi
  ;;
* | help | h) printf "%s\n" "${usage_message}" ;;
esac

# Return to original dir
cd "$DIR"
unset DIR
